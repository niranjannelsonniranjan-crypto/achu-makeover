# ---------------------------------------------------------------
# Achu Bridal Studio - Environment Configuration (example)
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
# ---------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/achu_bridal?retryWrites=true&w=majority

# JWT
# Use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=super_secret_change_me
JWT_EXPIRES_IN=7d

# Nodemailer (Gmail example - use an App Password, not your real password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
